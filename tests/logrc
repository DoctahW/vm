# rcfile da sessão gravada pelo `script`.
#
# O shell do dia a dia é fish: gravado direto, ele enche o evidencias.log de
# sequências de escape (autosuggestion, cores, título, reposição de cursor) e o
# log fica ilegível. A sessão de evidência roda num bash limpo com este rc:
#
#   script -a evidencias.log -c "bash --noprofile --rcfile tests/logrc -i"
#
# (comando válido tanto no fish quanto no bash)

PS1='[\u@\h \W]\$ '
PROMPT_COMMAND=
bind 'set enable-bracketed-paste off'
